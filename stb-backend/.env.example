# ==========================================
# STB Backend - Environment Variables
# ==========================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/stb_db

# JWT
JWT_ACCESS_SECRET=stb_access_super_secret_key_2024_enterprise
JWT_REFRESH_SECRET=stb_refresh_super_secret_key_2024_enterprise
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@stb.com.tn
SMTP_PASS=your_smtp_password
SMTP_FROM="STB Bank <noreply@stb.com.tn>"

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+21600000000

# App
APP_NAME=STB Mobile
APP_URL=https://api.stb.com.tn
FRONTEND_URL=https://stb.com.tn

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10
