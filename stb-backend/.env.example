# ==========================================
# STB Backend - Environment Variables
# ==========================================
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL VALUES

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/stb_db
MONGODB_DB_NAME=stb_db
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=5
MONGODB_SOCKET_TIMEOUT=30000
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# JWT (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_ACCESS_SECRET=your_access_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=30d
JWT_ISSUER=stb-backend
JWT_AUDIENCE=stb-mobile

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# Email (SMTP) - Use your own credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="STB RH Digi <your_email@gmail.com>"

# SMS (Twilio) - Optional
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+21600000000

# Firebase - Optional
FIREBASE_PROJECT_ID=stb-digital-banking
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@stb-digital-banking.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40stb-digital-banking.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=stb-digital-banking.appspot.com

# Redis - Optional
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# App
APP_NAME=STB Digital Banking
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173,http://localhost:8080

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# AI - Get your own key at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Security
SECURITY_BCRYPT_ROUNDS=12
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCK_DURATION_MINUTES=30
SECURITY_SESSION_TIMEOUT_MINUTES=60

# Banking
BANKING_DAILY_WITHDRAWAL_LIMIT=5000
BANKING_DAILY_TRANSFER_LIMIT=10000
BANKING_MONTHLY_TRANSFER_LIMIT=50000
BANKING_FRAUD_SCORE_THRESHOLD=70
