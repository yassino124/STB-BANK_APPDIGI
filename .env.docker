# ==========================================
# STB Enterprise System - Docker Environment
# ==========================================
# Copy this file to .env and fill in the values

# ── MongoDB ──────────────────────────────
MONGO_ROOT_USER=stb_admin
MONGO_ROOT_PASS=stb_secure_pass_2024
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=admin123

# ── JWT ──────────────────────────────────
JWT_ACCESS_SECRET=stb_access_super_secret_key_2024_enterprise
JWT_REFRESH_SECRET=stb_refresh_super_secret_key_2024_enterprise
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── OTP ──────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# ── Email (SMTP) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="STB RH Digi <noreply@stb.com.tn>"

# ── AI Copilot ───────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...your_key_here

# ── Rate Limiting ─────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
